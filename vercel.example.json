{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/start",
      "destination": "/index.html"
    },
    {
      "source": "/workshop",
      "destination": "/index.html"
    },
    {
      "source": "/workshop/:path*",
      "destination": "/index.html"
    }
  ]
}
